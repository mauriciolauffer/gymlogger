{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gymlogger-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gymlogger-db",
      "database_id": "gymlogger-db-id",
    },
  ],
  "vars": {
    "CORS_ORIGIN": "",
  },
  "secrets": {
    "required": ["JWT_SECRET", "APP_BASE_URL"],
  },
  "observability": {
    "enabled": true,
  },
}
