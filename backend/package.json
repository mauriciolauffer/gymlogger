{
  "name": "gymlogger-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "migrate:local": "wrangler d1 migrations apply gymlogger-db --local",
    "seed:local": "wrangler d1 execute gymlogger-db --local --file migrations/seed.sql",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "generate": "pnpm generate:migration && pnpm generate:dbml && pnpm generate:openapi",
    "generate:migration": "drizzle-kit generate --name=dbcreation",
    "generate:dbml": "drizzle-docs generate ./src/db/schema.ts -d sqlite -f dbml -o ../docs/schema.dbml --force",
    "generate:openapi": "hono-docs generate --config ./hono-docs.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@hono/structured-logger": "^1.0.0",
    "@hono/zod-validator": "^0.9.1",
    "@scalar/hono-api-reference": "^0.12.2",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@rcmade/hono-docs": "^1.4.0",
    "drizzle-docs-generator": "^0.8.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1"
  }
}
