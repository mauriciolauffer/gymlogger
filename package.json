{
  "name": "gymlogger-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter gymlogger-api --filter gymlogger-ui dev",
    "test": "pnpm test:api && pnpm test:ui",
    "test:api": "pnpm --filter gymlogger-api test",
    "test:ui": "pnpm --filter gymlogger-ui test",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxfmt --check && oxlint",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@cloudflare/vitest-plugin": "^1.2.4",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.137.0"
  },
  "packageManager": "pnpm@12.5.1"
}
