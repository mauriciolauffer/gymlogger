{
  "name": "gymlogger-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter backend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "test": "pnpm --filter backend test",
    "lint": "oxlint",
    "fmt": "oxfmt --write backend frontend *.json *.yaml"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  }
}
