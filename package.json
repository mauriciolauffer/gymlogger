{
  "name": "gymlogger-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter backend dev",
    "dev:ui": "pnpm --filter frontend dev",
    "test": "pnpm test:api && pnpm test:ui",
    "test:api": "pnpm --filter backend test",
    "test:ui": "pnpm --filter frontend test",
    "lint": "oxfmt --check && oxlint",
    "format": "oxfmt"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  }
}
