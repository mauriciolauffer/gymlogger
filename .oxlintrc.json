{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "eslint", "vitest", "vue", "promise", "import"],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "rules": {
    "import/no-unassigned-import": "off"
  },
  "env": {
    "builtin": true
  }
}
